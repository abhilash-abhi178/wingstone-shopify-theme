<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ page_title }}</title>
    {{ content_for_header }}

    {%- assign should_redirect = template != blank -%}

    {%- if settings.storefront_hostname != blank and should_redirect -%}
      <link rel="canonical" href="https://{{ settings.storefront_hostname }}{{ request.path }}">
      <script>
        (function () {
          if (window.Shopify && window.Shopify.designMode) return;

          var storefrontHostname = {{ settings.storefront_hostname | json }};
          var currentHostname = window.location.hostname;

          if (currentHostname === storefrontHostname) return;

          var target = new URL(window.location.href);
          target.hostname = storefrontHostname;
          target.protocol = 'https:';

          window.location.replace(target.toString());
        })();
      </script>
    {%- else -%}
      <link rel="canonical" href="{{ canonical_url }}">
    {%- endif -%}

    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #04102f;
        background: #f9f9ff;
        text-align: center;
      }
      a { color: #735b28; }
      .redirect { max-width: 520px; }
    </style>
  </head>
  <body>
    {%- if should_redirect -%}
      <main class="redirect">
        {%- if settings.storefront_hostname != blank -%}
          <p>Redirecting to WINGSTONE…</p>
          <p><a href="https://{{ settings.storefront_hostname }}/">Continue to WINGSTONE</a></p>
        {%- else -%}
          <p>Configure the storefront hostname in Theme settings.</p>
        {%- endif -%}
      </main>
    {%- endif -%}

    {{ content_for_layout }}
  </body>
</html>
