<section class="section section-404" aria-labelledby="404-title">
  <div class="page-width">
    <p class="eyebrow">404 // WINGSTONE</p>
    <h1 id="404-title" class="section-title">The piece you’re looking for doesn’t exist.</h1>
    <p>That page may have moved, sold out, or never existed. Let’s get you back to the collection.</p>
    <div class="section-404__actions">
      <a class="button" href="{{ routes.root_url }}">Return home</a>
      {% if collections.all.products_count > 0 %}
        <a class="button button--secondary" href="{{ routes.all_products_collection_url }}">Shop all</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "settings": []
}
{% endschema %}
